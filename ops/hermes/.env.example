# Copie este arquivo para um local seguro antes de usar por terminal.
# No Portainer, cadastre as mesmas variáveis na seção Environment variables.

HERMES_IMAGE_TAG=latest
HERMES_BIND_ADDRESS=127.0.0.1
HERMES_GATEWAY_PORT=8642
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD=0
HERMES_CPU_LIMIT=2.0
HERMES_MEMORY_LIMIT=1G
TZ=America/Sao_Paulo

# Segurança do gateway: mantenha a allowlist e informe os IDs permitidos.
GATEWAY_ALLOW_ALL_USERS=false
GATEWAY_ALLOWED_USERS=

# API HTTP do Hermes: desligada no primeiro estágio.
# Se ativar, defina uma chave longa e exclusiva.
API_SERVER_ENABLED=false
API_SERVER_KEY=

# Configure apenas um provedor com uma chave dedicada e limite de gastos.
# Nunca reutilize SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY ou EVOLUTION_API_KEY.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
